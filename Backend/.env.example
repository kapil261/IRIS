# Copy this file to .env and fill in real values, then: npm install && npm run dev

# Server
PORT=3001

# MongoDB — Atlas connection string, or a local mongodb://localhost:27017/iris
MONGO_URI=

# Auth — any long random string; used to sign JWTs
JWT_SECRET=

# Mistral (https://console.mistral.ai/api-keys) — PRIMARY chat model
MISTRAL_API_KEY=

# Groq (https://console.groq.com/keys) — AUTOMATIC FALLBACK if Mistral errors/rate-limits
IRIS_API_KEY=

# Pinecone (https://app.pinecone.io) — vector storage for document RAG.
# Embeddings run locally (Xenova/all-MiniLM-L6-v2, 384 dims) — no embedding API key needed.
# The index is created automatically on first use if it doesn't already exist.
PINECONE_API_KEY=
# Optional — defaults shown:
# PINECONE_INDEX_NAME=iris-docs-384
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# Google sign-in (https://console.cloud.google.com/apis/credentials → OAuth client ID, type "Web application").
# Add your frontend URL (e.g. http://localhost:5173) under "Authorized JavaScript origins".
# Only the client ID is needed for "Continue with Google"; it is served to the frontend via GET /api/auth/config.
GOOGLE_CLIENT_ID=

# Optional: where uploaded files are kept (only the "local" driver exists today)
# STORAGE_DRIVER=local
# UPLOAD_DIR=uploads

# Welcome email (Gmail). Either OAuth2 (GOOGLE_USER + GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET +
# GOOGLE_REFRESH_TOKEN from https://developers.google.com/oauthplayground with "Use your own
# OAuth credentials" and scope https://mail.google.com/) or GOOGLE_USER + GOOGLE_APP_PASSWORD.
GOOGLE_USER=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# GOOGLE_APP_PASSWORD=
# EMAIL_FROM_NAME=IRIS
# APP_URL=http://localhost:5173
# EMAIL_ENABLED=true
